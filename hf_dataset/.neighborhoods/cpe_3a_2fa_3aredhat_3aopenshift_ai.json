te":"rdf:type","object":"Vulnerability","source":"cve","object_type":"enum","object_canonical":"vulnerability"},{"subject":"CVE-2025-13327","predicate":"related-weakness","object":"CWE-1286","source":"cve","object_type":"id","object_canonical":"CWE-1286"},{"subject":"CVE-2025-13327","predicate":"state","object":"PUBLISHED","source":"cve","object_type":"enum","object_canonical":"published"},{"subject":"CVE-2025-13327","predicate":"vendor","object":"astral-sh","source":"cve","object_type":"string","object_canonical":"astral-sh"},{"subject":"CVE-2025-13327","predicate":"vendor","object":"Red Hat","source":"cve","object_type":"string","object_canonical":"red hat"},{"subject":"CVE-2026-12491","predicate":"affects-cpe","object":"cpe:/a:redhat:ai_inference_server:3","source":"cve","object_type":"id","object_canonical":"cpe:/a:redhat:ai_inference_server:3"},{"subject":"CVE-2026-12491","predicate":"affects-cpe","object":"cpe:/a:redhat:enterprise_linux_ai:3","source":"cve","object_type":"id","object_canonical":"cpe:/a:redhat:enterprise_linux_ai:3"},{"subject":"CVE-2026-12491","predicate":"assigner","object":"redhat","source":"cve","object_type":"string","object_canonical":"redhat"},{"subject":"CVE-2026-12491","predicate":"cvss-base-score","object":"4.8","source":"cve","object_type":"number","object_canonical":"4.8"},{"subject":"CVE-2026-12491","predicate":"cvss-severity","object":"MEDIUM","source":"cve","object_type":"enum","object_canonical":"medium"},{"subject":"CVE-2026-12491","predicate":"date-published","object":"2026-06-17T10:07:28.756Z","source":"cve","object_type":"date","object_canonical":"2026-06-17t10:07:28.756z"},{"subject":"CVE-2026-12491","predicate":"date-updated","object":"2026-07-07T07:44:29.614Z","source":"cve","object_type":"date","object_canonical":"2026-07-07t07:44:29.614z"},{"subject":"CVE-2026-12491","predicate":"description","object":"A flaw was found in vLLM, an open-source library for large language model inference. This vulnerability arises from improper handling of image metadata, specifically EXIF orientation and PNG transparency (tRNS) data, during image processing. When images are converted to RGB, transparency information may be implicitly discarded or remapped, leading to unexpected rendering of transparent pixels and distortion of input content. This can result in the model misinterpreting image content, potentially affecting the integrity of processed data.","source":"cve","object_type":"string","object_canonical":"a flaw was found in vllm, an open-source library for large language model inference. this vulnerability arises from improper handling of image metadata, specifically exif orientation and png transparency (trns) data, during image processing. when images are converted to rgb, transparency information may be implicitly discarded or remapped, leading to unexpected rendering of transparent pixels and distortion of input content. this can result in the model misinterpreting image content, potentially affecting the integrity of processed data."},{"subject":"CVE-2026-12491","predicate":"product","object":"vLLM","source":"cve","object_type":"string","object_canonical":"vllm"},{"subject":"CVE-2026-12491","predicate":"product","object":"Red Hat AI Inference Server","source":"cve","object_type":"string","object_canonical":"red hat ai inference server"},{"subject":"CVE-2026-12491","predicate":"product","object":"Red Hat Enterprise Linux AI (RHEL AI) 3","source":"cve","object_type":"string","object_canonical":"red hat enterprise linux ai (rhel ai) 3"},{"subject":"CVE-2026-12491","predicate":"product","object":"Red Hat OpenShift AI (RHOAI)","source":"cve","object_type":"string","object_canonical":"red hat openshift ai (rhoai)"},{"subject":"CVE-2026-12491","predicate":"rdf:type","object":"Vulnerability","source":"cve","object_type":"enum","object_canonical":"vulnerability"},{"subject":"CVE-2026-12491","predicate":"related-weakness","object":"CWE-115","source":"cve","object_type":"id","object_canonical":"CW